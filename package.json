{
  "name": "classdesk",
  "version": "0.4.1",
  "description": "课堂桌面工具",
  "author": "yizigezi",
  "private": true,
  "main": "./out/main/index.js",
  "build": {
    "appId": "cn.yizigezi.classdesk",
    "productName": "classdesk",
    "artifactName": "classdesk-win32-x64-${version}.${ext}",
    "directories": {
      "output": "dist-test",
      "buildResources": ".tmp/build-resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "classdesk-win32-x64-${version}-portable.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs",
    "build:raw": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "pinia": "^3.0.2",
    "pptx-vue-viewer": "^4.43.0",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
