{
  "name": "classdesk",
  "version": "0.1.0",
  "description": "课堂桌面工具",
  "private": true,
  "main": "./out/main/index.js",
  "build": {
    "appId": "cn.yizigezi.classdesk",
    "productName": "classdesk",
    "artifactName": "classdesk-win32-x64-${version}-${target}.${ext}",
    "directories": {
      "output": "dist-test",
      "buildResources": ".tmp/build-resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "classdesk-win32-x64-${version}-portable.${ext}"
    },
    "zip": {
      "artifactName": "classdesk-win32-x64-${version}.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "axios": "^1.7.9",
    "clipboard": "^2.0.11",
    "crypto-js": "^4.2.0",
    "dexie": "^4.0.11",
    "echarts": "^6.0.0",
    "file-saver": "^2.0.5",
    "hfmath": "^0.0.2",
    "html-to-image": "^1.11.13",
    "jsonrepair": "^3.13.2",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "nanoid": "^5.0.7",
    "number-precision": "^1.6.0",
    "pinia": "^3.0.2",
    "pptxgenjs": "^3.12.0",
    "pptxtojson": "^2.2.0",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.2",
    "prosemirror-schema-basic": "^1.2.3",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.33.9",
    "svg-pathdata": "^7.1.0",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.17",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/icon-park-solid": "^1.2.4",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "sass": "1.69.6",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
