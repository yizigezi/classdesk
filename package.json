{
  "name": "quickclass-de",
  "version": "0.5.0",
  "description": "QuickClass Desktop Environment",
  "author": "yizigezi",
  "private": true,
  "main": "./out/main/index.js",
  "build": {
    "appId": "cn.yizigezi.quickclassde",
    "productName": "QuickClass DE",
    "artifactName": "quickclass-de-win32-x64-${version}.${ext}",
    "directories": {
      "output": "dist-test",
      "buildResources": ".tmp/build-resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist-apps",
        "to": "apps-system",
        "filter": [
          "**/*.cdapp"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs && node scripts/build-apps.mjs && electron-builder --win --x64 --publish never",
    "build:shell": "node scripts/build.mjs",
    "build:apps": "node scripts/build-apps.mjs",
    "build:raw": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.0",
    "pinia": "^3.0.2",
    "pptx-vue-viewer": "^4.43.0",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
